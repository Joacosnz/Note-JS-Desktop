{
  "name": "note-js",
  "version": "1.0.0",
  "description": "Note JS - Desktop App para PC con PyWebView y SQLite + Peewee ORM",
  "scripts": {
    "start": "python3 server.py",
    "dev": "python3 server.py",
    "desktop": "python3 desktop_app.py",
    "build:exe": "pyinstaller --noconsole --onefile --add-data \"frontend;frontend\" --hidden-import peewee --hidden-import models --name \"NoteJS\" desktop_app.py",
    "build": "python3 -m py_compile models.py backend.py desktop_app.py"
  },
  "keywords": ["pywebview", "sqlite", "peewee", "python", "notes"],
  "author": "",
  "license": "ISC"
}
